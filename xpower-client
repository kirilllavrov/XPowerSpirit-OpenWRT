#!/bin/sh

CONFIG_DIR="${XRAY_CONFIG_DIR:-/etc/xray}"
CONFIG_JSON="${XRAY_CONFIG_JSON:-$CONFIG_DIR/config.json}"
SETTINGS_JSON="${XRAY_SETTINGS_JSON:-$CONFIG_DIR/settings.json}"
SETTINGS_DEFAULTS="${XRAY_SETTINGS_DEFAULTS:-/usr/share/xray/settings.default.json}"
XRAY_BIN="${XRAY_BIN:-/usr/bin/xray}"
XRAY_INIT="${XRAY_INIT:-/etc/init.d/xray}"
UPDATER="${XRAY_UPDATER:-/usr/share/xray/update-xray.sh}"
NFT_UPDATER="${XRAY_NFT_UPDATER:-/usr/share/xray/update_nft.py}"

# Оформление: цвета и иконки только при выводе в терминал.
# NO_COLOR=1 или --no-color отключают их (журналы и скрипты получают чистый текст).
plain=0
case " $* " in
*" --no-color "*) plain=1 ;;
esac
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "$plain" = 0 ]; then
    C_G=$(printf '\033[32m')
    C_R=$(printf '\033[31m')
    C_Y=$(printf '\033[33m')
    C_D=$(printf '\033[2m')
    C_B=$(printf '\033[1m')
    C_0=$(printf '\033[0m')
    I_OK='✔'
    I_BAD='✖'
    I_WARN='⚠'
else
    C_G=
    C_R=
    C_Y=
    C_D=
    C_B=
    C_0=
    I_OK='+'
    I_BAD='x'
    I_WARN='!'
fi

status_ok() { printf '%s%s%s %s\n' "$C_G" "$I_OK" "$C_0" "$*"; }
status_bad() { printf '%s%s%s %s\n' "$C_R" "$I_BAD" "$C_0" "$*"; }
status_warn() { printf '%s%s%s %s\n' "$C_Y" "$I_WARN" "$C_0" "$*"; }

# Русское склонение: plural_ru 4 узел узла узлов → «узла»
plural_ru() {
    count=$1
    case $((count % 100)) in
    11 | 12 | 13 | 14)
        printf '%s' "$4"
        return
        ;;
    esac
    case $((count % 10)) in
    1) printf '%s' "$2" ;;
    2 | 3 | 4) printf '%s' "$3" ;;
    *) printf '%s' "$4" ;;
    esac
}

# Человеко-понятная длительность: 3 ч 12 мин
human_duration() {
    seconds=$1
    days=$((seconds / 86400))
    hours=$(((seconds % 86400) / 3600))
    minutes=$(((seconds % 3600) / 60))
    if [ "$days" -gt 0 ]; then
        printf '%d сут %d ч' "$days" "$hours"
    elif [ "$hours" -gt 0 ]; then
        printf '%d ч %d мин' "$hours" "$minutes"
    else
        printf '%d мин' "$minutes"
    fi
}

# Аптайм процесса по /proc/<pid>/stat (busybox ps не умеет etime)
proc_uptime() {
    pid=$1
    [ -r "/proc/$pid/stat" ] || return 1
    start_ticks=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null)
    [ -n "$start_ticks" ] || return 1
    ticks_per_sec=$(getconf CLK_TCK 2>/dev/null || echo 100)
    uptime_sec=$(cut -d. -f1 /proc/uptime 2>/dev/null)
    [ -n "$uptime_sec" ] || return 1
    age=$((uptime_sec - start_ticks / ticks_per_sec))
    [ "$age" -ge 0 ] || return 1
    human_duration "$age"
}

# Внешний IP: cloudflare trace не входит в geosite:category-ipcheck,
# поэтому запрос идёт через прокси и показывает реальный выход
external_ip() {
    # -4: показываем IPv4, если узел его поддерживает (иначе останется IPv6)
    ip=$(curl -4 -fsS -m 6 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null |
        awk -F= '/^ip=/ {print $2; exit}')
    if [ -z "$ip" ]; then
        ip=$(curl -fsS -m 6 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null |
            awk -F= '/^ip=/ {print $2; exit}')
    fi
    if [ -z "$ip" ]; then
        ip=$(curl -4 -fsS -m 6 https://check.torproject.org/api/ip 2>/dev/null |
            sed -n 's/.*"IP":"\([^"]*\)".*/\1/p')
    fi
    printf '%s' "$ip"
}

# Профили из тегов proxy-<профиль>-<N>: «имя число» построчно
profile_stats() {
    python3 -B - "$CONFIG_JSON" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        config = json.load(source)
except (OSError, ValueError):
    sys.exit(1)

groups = {}
for outbound in config.get("outbounds") or []:
    tag = outbound.get("tag") if isinstance(outbound, dict) else None
    if not isinstance(tag, str) or not tag.startswith("proxy-"):
        continue
    name = tag[len("proxy-"):]
    tail = name.rsplit("-", 1)[-1]
    if tail.isdigit():
        name = name.rsplit("-", 1)[0]
    groups[name] = groups.get(name, 0) + 1

for name in sorted(groups, key=lambda n: (-groups[n], n)):
    print("%s %d" % (name, groups[name]))
PY
}

# Пул балансировщиков: «tag (strategy)» через запятую
balancer_stats() {
    python3 -B - "$CONFIG_JSON" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        config = json.load(source)
except (OSError, ValueError):
    sys.exit(1)

pools = []
for balancer in (config.get("routing") or {}).get("balancers") or []:
    if not isinstance(balancer, dict):
        continue
    strategy = (balancer.get("strategy") or {}).get("type") or "?"
    pools.append("%s (%s)" % (balancer.get("tag", "?"), strategy))
print(" + ".join(pools))
PY
}

