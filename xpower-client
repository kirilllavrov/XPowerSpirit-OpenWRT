proxy_list() {
    python3 -B - "$CONFIG_JSON" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        config = json.load(source)
except (OSError, ValueError) as error:
    print(f"Не удалось прочитать config.json: {error}", file=sys.stderr)
    sys.exit(1)

excluded = {"freedom", "blackhole", "dns", "loopback"}
proxies = [outbound for outbound in config.get("outbounds", [])
           if isinstance(outbound, dict)
           and outbound.get("protocol") not in excluded]
print(f"Прокси-серверов: {len(proxies)}")
if not proxies:
    print("  (DIRECT режим)")

for outbound in proxies:
    protocol = outbound.get("protocol", "?")
    settings = outbound.get("settings") or {}
    servers = settings.get("vnext") or settings.get("servers") or []
    server = servers[0] if servers and isinstance(servers[0], dict) else {}
    address = server.get("address", "?")
    port = server.get("port", "?")
    stream = outbound.get("streamSettings") or {}
    transport = stream.get("method") or stream.get("network") or "?"
    print(f"  [{outbound.get('tag', '?')}] {protocol} {address}:{port} "
          f"({transport}/{stream.get('security', 'none')})")
PY
}

human_bytes() {
    awk -v bytes="${1:-0}" 'BEGIN {
        split("Б КБ МБ ГБ ТБ", units, " ");
        i = 1;
        while (bytes >= 1024 && i < 5) { bytes /= 1024; i++ }
        printf (i == 1 ? "%.0f %s" : "%.1f %s"), bytes, units[i];
    }'
}

# Доля ветки маршрутизации (proxy|direct|block) в общем объёме, проценты
traffic_share() {
    printf '%s\n' "$1" | awk -v k="$2" '
        /^TOTAL/ { total = $2 + $3 }
        $1 == "GROUP" && $2 == k { branch = $3 + $4 }
        END { printf "%d", (total > 0 && branch) ? int(branch * 100 / total + 0.5) : 0 }'
}

traffic_stats() {
    [ -x "$XRAY_BIN" ] || return 1
    port=$(api_port) || return 1
    raw=$("$XRAY_BIN" api statsquery --server="127.0.0.1:$port" -pattern "" 2>/dev/null) ||
        return 1
    [ -n "$raw" ] || return 1

    printf '%s' "$raw" | python3 -B -c '
import json
import re
import sys

raw = sys.stdin.read()
try:
    data = json.loads(raw)
except ValueError:
    data = None

items = data.get("stat") or [] if isinstance(data, dict) else data
pairs = []
if isinstance(items, list):
    for item in items:
        if isinstance(item, dict):
            try:
                pairs.append((str(item.get("name", "")), int(item.get("value", 0) or 0)))
            except (TypeError, ValueError):
                continue

if not pairs:
    for chunk in raw.split("name:"):
        quoted = chunk.split(chr(34))
        value = re.search(r"value:\s*(\d+)", chunk)
        if len(quoted) > 1 and value:
            pairs.append((quoted[1], int(value.group(1))))

if not pairs:
    sys.exit(1)

# Считаем только outbound: inbound>>>tproxy-in повторяет те же байты со стороны
# клиента, и сумма inbound+outbound давала удвоенный объём
total = [0, 0]
nodes = {}
# direct и block — не узлы, а ветки маршрутизации: показываем их отдельными группами
groups = {"direct": [0, 0], "block": [0, 0]}
groups["proxy"] = [0, 0]
for name, value in pairs:
    parts = name.split(">>>")
    if len(parts) != 4 or parts[0] != "outbound" or parts[2] != "traffic":
        continue
    direction = parts[3]
    if direction not in ("uplink", "downlink"):
        continue
    index = 0 if direction == "uplink" else 1
    tag = parts[1]
    total[index] += value
    if tag.startswith("proxy-"):
        groups["proxy"][index] += value
        node = nodes.setdefault(tag, [0, 0])
        node[index] += value
    elif tag in groups:
        groups[tag][index] += value

print("TOTAL %d %d" % (total[0], total[1]))
for kind in ("proxy", "direct", "block"):
    if groups[kind][0] or groups[kind][1]:
        print("GROUP %s %d %d" % (kind, groups[kind][0], groups[kind][1]))
ranked = sorted(nodes.items(), key=lambda item: sum(item[1]), reverse=True)
print("COUNT %d" % len(ranked))
for tag, values in ranked:
    print("NODE %s %d %d" % (tag, values[0], values[1]))
' 2>/dev/null
}

show_traffic() {
    stats=$(traffic_stats) || {
        echo "Нет данных: Xray не запущен, API недоступен или счётчики не включены." >&2
        echo "Перегенерируйте конфиг командой: xpower-client update" >&2
        return 1
    }

    up=$(printf '%s\n' "$stats" | awk '/^TOTAL/ {print $2}')
    down=$(printf '%s\n' "$stats" | awk '/^TOTAL/ {print $3}')
    printf 'Через Xray: ↑ %s  ↓ %s\n' "$(human_bytes "$up")" "$(human_bytes "$down")"

    # Доли веток маршрутизации: сколько ушло в туннель, сколько напрямую
    printf '\n'
    for kind in proxy direct block; do
        line=$(printf '%s\n' "$stats" | awk -v k="GROUP $kind" '$1" "$2 == k {print $3, $4}')
        [ -n "$line" ] || continue
        set -- $line
        share=$(traffic_share "$stats" "$kind")
        case "$kind" in
        proxy) label="Прокси " ;;
        direct) label="Direct " ;;
        *) label="Block  " ;;
        esac
        printf '  %s %s%%  ↑ %s  ↓ %s\n' "$label" "$share" \
            "$(human_bytes "$1")" "$(human_bytes "$2")"
    done
    printf '\n'

    nodes=$(printf '%s\n' "$stats" | awk '/^NODE/ {print}')
    if [ -z "$nodes" ]; then
        echo "Трафика через прокси-серверы пока не было."
        return 0
    fi
    # %-24s в printf считает байты, а кириллица занимает два: таблица съезжала.
    # Python выравнивает по числу символов, что и видит моноширинный шрифт
    printf '%s\n' "$nodes" | python3 -B -c '
import sys

def human(size):
    units = ("Б", "КБ", "МБ", "ГБ", "ТБ")
    index = 0
    size = float(size)
    while size >= 1024 and index < 4:
        size /= 1024
        index += 1
    return "%.0f %s" % (size, units[index]) if index == 0 else "%.1f %s" % (size, units[index])

rows = []
for line in sys.stdin:
    parts = line.split()
    if len(parts) != 4 or parts[0] != "NODE":
        continue
    rows.append((parts[1], human(int(parts[2])), human(int(parts[3]))))
if not rows:
    sys.exit(0)

tag_width = max([len("сервер")] + [len(r[0]) for r in rows])
up_width = max([len("отдано")] + [len(r[1]) for r in rows])
down_width = max([len("принято")] + [len(r[2]) for r in rows])

print("  %s  %s  %s" % ("сервер".ljust(tag_width),
                        "отдано".rjust(up_width), "принято".rjust(down_width)))
for tag, up, down in rows:
    print("  %s  %s  %s" % (tag.ljust(tag_width), up.rjust(up_width), down.rjust(down_width)))
'
}

do_status() {
    mode="compact"
    net=1
    for arg in "$@"; do
        case "$arg" in
        --full) mode="full" ;;
        --short) mode="short" ;;
        --no-net) net=0 ;;
        --no-color) : ;;
        *)
            echo "Неизвестный параметр status: $arg" >&2
            echo "Использование: xpower-client status [--full|--short] [--no-net]" >&2
            return 2
            ;;
        esac
    done

    pid=$(pidof xray 2>/dev/null | awk '{print $1}')
    if [ -n "$pid" ]; then
        running=1
        started="работает $(proc_uptime "$pid" 2>/dev/null || echo '?')"
    else
        running=0
        started="остановлен"
    fi
    version=""
    [ -x "$XRAY_BIN" ] && version=$("$XRAY_BIN" version 2>/dev/null | head -1 | awk '{print $2}')

    model=$(setting_value '.device_model')
    os_ver=$(setting_value '.ver_os')
    deploy_mode=$(setting_value '.mode')
    [ -n "$deploy_mode" ] || deploy_mode=router
    tproxy_port=$(config_port tproxy-in 2>/dev/null)
    dns_port=$(setting_value '.tproxy.dns_port')
    fwmark=$(setting_value '.tproxy.fwmark')
    table=$(setting_value '.tproxy.route_table')

    nft_ok=0
    if nft list table inet xray_prerouting >/dev/null 2>&1 &&
        nft list table inet xray_self >/dev/null 2>&1; then
        nft_ok=1
    fi
    bypass=$(nft list table inet xray_prerouting 2>/dev/null | grep -c 'return')

    rule_ok=0
    if [ -n "$fwmark" ] && [ -n "$table" ]; then
        fwmark_hex=$(printf '0x%x' "$fwmark" 2>/dev/null)
        if ip rule show 2>/dev/null |
            grep -Eq "fwmark (${fwmark_hex}|0x0*${fwmark}|${fwmark}) lookup (${table}|xray)"; then
            rule_ok=1
        fi
    fi

    dns_ok=0
    if [ -n "$dns_port" ] &&
        uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "127.0.0.1#$dns_port"; then
        dns_ok=1
    fi

    config_ok=0
    config_size=""
    config_when=""
    if [ -f "$CONFIG_JSON" ]; then
        config_ok=1
        config_size=$(human_bytes "$(wc -c <"$CONFIG_JSON" | tr -d ' ')")
        config_when=$(date -r "$CONFIG_JSON" '+%d.%m %H:%M' 2>/dev/null)
    fi

    profiles=$(profile_stats 2>/dev/null)
    profile_count=$(printf '%s\n' "$profiles" | awk 'NF {n++} END {print n+0}')
    node_count=$(printf '%s\n' "$profiles" | awk 'NF {s+=$NF} END {print s+0}')
    top_profiles=$(printf '%s\n' "$profiles" | head -3 |
        awk 'NF {printf "%s%s %s", sep, $1, $NF; sep=" · "}')
    pools=$(balancer_stats 2>/dev/null)

    cron_sub=$(crontab -l 2>/dev/null | grep -F "$UPDATER --config-only" | head -1 | cut -d' ' -f1-5)
    cron_xray=$(crontab -l 2>/dev/null | grep -F "$UPDATER >>" | head -1 | cut -d' ' -f1-5)

    wan_iface=$(ip route 2>/dev/null | awk '/^default/ {print $5; exit}')
    wan_gw=$(ip route 2>/dev/null | awk '/^default/ {print $3; exit}')
    wan_ip=""
    wan_ssid=""
    if [ -n "$wan_iface" ]; then
        wan_ip=$(ip -4 addr show "$wan_iface" 2>/dev/null | awk '/inet / {print $2; exit}')
        case "$wan_iface" in
        *sta*) wan_ssid=$(iw dev "$wan_iface" link 2>/dev/null | sed -n 's/.*SSID: //p' | head -1) ;;
        esac
    fi

    traffic=""
    if stats=$(traffic_stats 2>/dev/null); then
        up=$(printf '%s\n' "$stats" | awk '/^TOTAL/ {print $2}')
        down=$(printf '%s\n' "$stats" | awk '/^TOTAL/ {print $3}')
        used=$(printf '%s\n' "$stats" | grep -c '^NODE')
        share_proxy=$(traffic_share "$stats" proxy)
        share_direct=$(traffic_share "$stats" direct)
        traffic=$(printf '↑ %s ↓ %s · прокси %s%% / direct %s%% · узлов: %s' \
            "$(human_bytes "${up:-0}")" "$(human_bytes "${down:-0}")" \
            "$share_proxy" "$share_direct" "$used")
    fi

    sub_url=$(setting_value '.subscription.url')
    hwid=$(setting_value '.hwid')

    # --- короткий режим: одна строка ---
    if [ "$mode" = "short" ]; then
        [ "$running" = 1 ] && mark="$C_G$I_OK$C_0" || mark="$C_R$I_BAD$C_0"
        volumes=""
        if stats=$(traffic_stats 2>/dev/null); then
            up=$(printf '%s\n' "$stats" | awk '/^TOTAL/ {print $2}')
            down=$(printf '%s\n' "$stats" | awk '/^TOTAL/ {print $3}')
            volumes=" · ↑$(human_bytes "${up:-0}") ↓$(human_bytes "${down:-0}")"
        fi
        printf '%s Xray %s · %s %s%s\n' "$mark" "${version:-?}" "$node_count" \
            "$(plural_ru "$node_count" узел узла узлов)" "$volumes"
        return 0
    fi

    # --- заголовок ---
    printf '%sXPowerSpirit%s' "$C_B" "$C_0"
    [ -n "$model" ] && printf ' · %s' "$model"
    [ -n "$os_ver" ] && printf ' · OpenWrt %s' "$os_ver"
    [ "$deploy_mode" = "gateway" ] && printf ' · шлюз'
    printf '\n'

    if [ "$running" = 1 ]; then
        status_ok "Xray ${version:-?} $started"
    else
        status_bad "Xray остановлен${version:+ (версия $version)}"
    fi

    if [ "$nft_ok" = 1 ] && [ "$rule_ok" = 1 ]; then
        status_ok "TProxy: порт ${tproxy_port:-?} · fwmark $fwmark → table $table · bypass $bypass"
    elif [ "$nft_ok" = 1 ]; then
        status_warn "TProxy: правила есть, но нет ip rule для fwmark $fwmark → table $table"
    else
        status_bad "TProxy: правила nftables не загружены (xpower-client setup)"
    fi

    if [ "$dns_ok" = 1 ]; then
        status_ok "DNS: dnsmasq → 127.0.0.1:$dns_port"
    elif [ -n "$dns_port" ]; then
        status_warn "DNS: dnsmasq не перенаправлен на 127.0.0.1:$dns_port"
    else
        status_warn "DNS: порт не задан (tproxy.dns_port)"
    fi

    if [ "$config_ok" = 1 ] && [ -n "$sub_url" ]; then
        status_ok "Подписка: $(mask_url "$sub_url") · HWID $(printf '%s' "${hwid:-—}" | cut -c1-8)… · конфиг $config_when"
    elif [ "$config_ok" = 1 ]; then
        status_warn "Подписка: URL не задан · конфиг $config_when"
    else
        status_bad "Конфигурация не собрана (xpower-client update)"
    fi

    [ -n "$traffic" ] && printf '  %sТрафик:%s %s\n' "$C_D" "$C_0" "$traffic"

    if [ "$net" = 1 ]; then
        ext=$(external_ip)
        if [ -n "$ext" ]; then
            printf '  %sВнешний IP:%s %s %s(через прокси)%s\n' "$C_D" "$C_0" "$ext" "$C_D" "$C_0"
        else
            printf '  %sВнешний IP: нет ответа — проверьте сеть (test)%s\n' "$C_Y" "$C_0"
        fi
    fi

    # --- детали ---
    printf '\n'
    if [ "$profile_count" -gt 0 ]; then
        extra=""
        [ "$profile_count" -gt 3 ] && extra=" +$((profile_count - 3))"
        nodes_word=$(plural_ru "$node_count" узел узла узлов)
        if [ "$profile_count" -eq 1 ]; then
            printf '  Узлы:        %s %s в профиле %s\n' \
                "$node_count" "$nodes_word" "$top_profiles"
        else
            printf '  Узлы:        %s %s в %s профилях (%s%s)\n' \
                "$node_count" "$nodes_word" "$profile_count" "$top_profiles" "$extra"
        fi
    else
        printf '  Узлы:        нет узлов proxy-* в конфигурации\n'
    fi
    [ -n "$pools" ] && printf '  Пул:         %s\n' "$pools"

    if [ -n "$wan_iface" ]; then
        wan_line="$wan_iface"
        [ -n "$wan_ssid" ] && wan_line="$wan_line ($wan_ssid)"
        [ -n "$wan_ip" ] && wan_line="$wan_line $wan_ip"
        [ -n "$wan_gw" ] && wan_line="$wan_line · шлюз $wan_gw"
        if [ "$deploy_mode" = "gateway" ]; then
            printf '  LAN:         %s · режим: шлюз\n' "$wan_line"
        else
            printf '  WAN:         %s\n' "$wan_line"
        fi
    elif [ "$deploy_mode" = "gateway" ]; then
        printf '  LAN:         маршрута по умолчанию нет · режим: шлюз\n'
    else
        printf '  WAN:         маршрута по умолчанию нет\n'
    fi

    update_line=""
    [ -n "$cron_sub" ] && update_line="подписка $cron_sub"
    [ -n "$cron_xray" ] && update_line="${update_line:+$update_line · }Xray+гео $cron_xray"
    [ -n "$config_when" ] && update_line="${update_line:+$update_line · }конфиг $config_when"
    [ -n "$config_size" ] && update_line="$update_line ($config_size)"
    [ -n "$update_line" ] && printf '  Обновление:  %s\n' "$update_line"

    if [ "$mode" = "full" ] && [ "$config_ok" = 1 ]; then
        printf '\n'
        proxy_list
    fi

    printf '\n%sДетали:%s proxy-list · traffic · sub · doctor · test\n' "$C_D" "$C_0"
}

do_test() {
    failed=0
    probe=$(setting_value '.health.probe_url')

    printf 'Интернет: '
    if [ -n "$probe" ] && curl -fsS --max-time 5 "$probe" -o /dev/null 2>/dev/null; then
        echo "OK"
    else
        echo "ошибка проверки ${probe:-health.probe_url не задан}"
        failed=1
    fi

    dns_port=$(config_port dns-local 2>/dev/null || true)
    if [ -z "$dns_port" ]; then
        echo "DNS Xray: отключён (dns-local отсутствует)"
    elif uci -q show 'dhcp.@dnsmasq[0].server' 2>/dev/null |
        grep -qF "127.0.0.1#$dns_port" &&
        resolveip -4 example.com >/dev/null 2>&1; then
        echo "DNS Xray: OK (порт $dns_port через системный резолвер)"
    else
        echo "DNS Xray: dnsmasq не настроен на порт $dns_port или example.com не разрешён"
        failed=1
    fi

    tproxy_port=$(config_port tproxy-in 2>/dev/null || true)
    if [ -n "$tproxy_port" ] && nft list table inet xray_prerouting 2>/dev/null |
        grep -q "tproxy ip to 127.0.0.1:$tproxy_port"; then
        echo "TProxy:   правило для порта $tproxy_port найдено"
    else
        echo "TProxy:   правило не найдено"
        failed=1
    fi

    if [ "$failed" -eq 0 ]; then
        return 0
    fi
    return 1
}

do_config() {
    [ -f "$CONFIG_JSON" ] || {
        echo "config.json не найден: $CONFIG_JSON" >&2
        return 1
    }
    python3 -B - "$CONFIG_JSON" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        text = json.dumps(json.load(source), indent=2, ensure_ascii=False)
except (OSError, ValueError) as error:
    print(f"Не удалось прочитать config.json: {error}", file=sys.stderr)
    sys.exit(1)

lines = text.splitlines()
print("\n".join(lines[:100]))
if len(lines) > 100:
    print(f"... (ещё {len(lines) - 100} строк)")
PY
}

require_init() {
    [ -x "$XRAY_INIT" ] || {
        echo "Init-скрипт Xray не найден: $XRAY_INIT" >&2
        return 1
    }
}

command=${1:-}
# Любая команда с -h/--help показывает свою справку
case "${2:-}" in
-h | --help)
    help_for "$command"
    exit 0
    ;;
esac

case "$command" in
    "")
        # Без команды — это ошибка вызова, а не «неизвестная команда»
        usage >&2
        exit 2
        ;;

    status)
        shift
        do_status "$@"
        exit $?
        ;;
    start | stop | restart)
        require_init || exit 1
        "$XRAY_INIT" "$command"
        ;;
    toggle)
        require_init || exit 1
        if pidof xray >/dev/null 2>&1; then
            "$XRAY_INIT" stop
        else
            "$XRAY_INIT" start
        fi
        ;;
    update)
        [ -x "$UPDATER" ] || {
            echo "Скрипт обновления не найден: $UPDATER" >&2
            exit 1
        }
        shift
        exec "$UPDATER" "$@"
        ;;
    test)
        do_test
        ;;
    traffic)
        show_traffic
        ;;
    logs)
        if command -v logread >/dev/null 2>&1; then
            exec logread -f -e xray
        fi
        exec tail -f /tmp/log/xray-error.log /tmp/log/xray-update.log
        ;;
    config)
        do_config
        ;;
    proxy-list)
        proxy_list
        exit $?
        ;;
    settings)
        shift
        do_settings "$@"
        exit $?
        ;;
    setup)
        [ -f "$NFT_UPDATER" ] || {
            echo "Скрипт настройки nftables не найден: $NFT_UPDATER" >&2
            exit 1
        }
        exec python3 -B "$NFT_UPDATER"
        ;;
    help)
        shift
        help_for "${1:-}"
        exit $?
        ;;
    sub)
        shift
        do_sub "$@"
        exit $?
        ;;
    doctor)
        shift
        do_doctor "$@"
        exit $?
        ;;
    -h | --help)
        usage
        ;;
    *)
        echo "Неизвестная команда: ${command:-<пусто>}" >&2
        echo "Список команд: xpower-client help" >&2
        exit 2
        ;;
esac
