do_doctor() {
    diag="${XRAY_DIAGNOSE:-/usr/share/xray/diagnose-xray-tproxy.sh}"

    if [ ! -f "$diag" ]; then
        if [ "$1" = "--download" ]; then
            tmp_diag="/tmp/diagnose-xray-tproxy.sh"
            url="${XRAY_DIAGNOSE_URL:-https://raw.githubusercontent.com/kirilllavrov/XPowerSpirit-OpenWRT/main/diagnose-xray-tproxy.sh}"
            echo "Скачиваю скрипт диагностики…"
            curl -fsSL "$url" -o "$tmp_diag" || {
                echo "Не удалось скачать $url" >&2
                return 1
            }
            sh -n "$tmp_diag" || {
                echo "Скачанный скрипт не прошёл проверку синтаксиса" >&2
                rm -f "$tmp_diag"
                return 1
            }
            diag="$tmp_diag"
        else
            echo "Скрипт диагностики не установлен: $diag" >&2
            echo "Скачать и запустить: xpower-client doctor --download" >&2
            return 1
        fi
    fi

    shift 2>/dev/null || true
    exec sh "$diag" "$@"
}

config_port() {
    python3 -B - "$CONFIG_JSON" "$1" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        config = json.load(source)
except (OSError, ValueError):
    sys.exit(1)

tag = sys.argv[2]
for inbound in config.get("inbounds", []):
    if isinstance(inbound, dict) and inbound.get("tag") == tag:
        print(inbound.get("port", ""))
        break
else:
    sys.exit(1)
PY
}

