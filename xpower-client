# Сводка по settings.json: что реально действует, с пометкой значений из эталона
do_settings() {
    for arg in "$@"; do
        case "$arg" in
        --no-color) : ;;
        *)
            echo "Неизвестный параметр settings: $arg" >&2
            echo "Использование: xpower-client settings" >&2
            return 2
            ;;
        esac
    done
    require_settings || return 1

    XP_C_B="$C_B" XP_C_D="$C_D" XP_C_0="$C_0" \
        python3 -B - "$SETTINGS_JSON" "$SETTINGS_DEFAULTS" <<'PY'
import json
import os
import sys

SETTINGS_PATH, DEFAULTS_PATH = sys.argv[1], sys.argv[2]
BOLD = os.environ.get("XP_C_B", "")
DIM = os.environ.get("XP_C_D", "")
OFF = os.environ.get("XP_C_0", "")
WIDTH = 18


def load(path):
    try:
        with open(path, encoding="utf-8") as source:
            data = json.load(source)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


settings = load(SETTINGS_PATH) or {}
defaults = load(DEFAULTS_PATH) or {}
covered = []


def raw(path):
    """Значение из settings.json, иначе из эталона: (value, is_default)."""
    for data, is_default in ((settings, False), (defaults, True)):
        node = data
        for key in path.split("."):
            if not isinstance(node, dict) or key not in node:
                node = None
                break
            node = node[key]
        else:
            return node, is_default
    return None, True


def text(value):
    if value is None:
        return "—"
    if isinstance(value, bool):
        return "да" if value else "нет"
    if value == "":
        return "—"
    return str(value)


def mask_url(url):
    if not isinstance(url, str) or not url:
        return "—"
    return url if len(url) <= 24 else url[:14] + "…" + url[-4:]


def mask_hwid(hwid):
    if not isinstance(hwid, str) or not hwid:
        return "—"
    return hwid[:8] + "…" if len(hwid) > 8 else hwid[:3] + "…"


def section(title):
    print("\n%s%s%s" % (BOLD, title, OFF))


def line(label, value):
    print("  %s %s" % (label.ljust(WIDTH), value))


def field(label, path, render=text):
    value, is_default = raw(path)
    covered.append(path)
    mark = DIM + " (эталон)" + OFF if is_default else ""
    line(label, "%s%s" % (render(value), mark))


def items(label, path):
    """Список в строку, если коротко; иначе — по элементу на строку."""
    value, is_default = raw(path)
    covered.append(path)
    mark = DIM + " (эталон)" + OFF if is_default else ""
    values = [text(item) for item in value] if isinstance(value, list) else []
    if not values:
        line(label, "—" + mark)
    elif len(", ".join(values)) <= 52:
        line(label, ", ".join(values) + mark)
    else:
        print("  %s" % label)
        for item in values:
            print("      %s" % item)
        if mark:
            print("      %s" % mark.strip())


def blocks(label, path, render):
    """Список объектов: каждый элемент — строка render(item)."""
    value, is_default = raw(path)
    covered.append(path)
    entries = [render(item) for item in value] if isinstance(value, list) else []
    if not entries:
        line(label, "—")
        return
    print("  %s" % label)
    for number, entry in enumerate(entries, 1):
        print("    %d  %s" % (number, entry))
    if is_default:
        print("    %s(эталон)%s" % (DIM, OFF))


def flatten(node, prefix=""):
    if isinstance(node, dict):
        if not node:
            yield prefix, {}
        for key, value in node.items():
            yield from flatten(value, "%s.%s" % (prefix, key) if prefix else key)
    else:
        yield prefix, node


def is_covered(path):
    return any(path == done or path.startswith(done + ".") for done in covered)


print("%sНастройки%s · %s" % (BOLD, OFF, SETTINGS_PATH))
print("  %sэталон: %s%s" % (DIM, DEFAULTS_PATH if defaults else "не найден", OFF))

