# Скрывает середину токена: https://host/abc123def → https://host/abc1…3def
mask_url() {
    python3 -B - "$1" <<'PY'
import sys

url = sys.argv[1]
if len(url) <= 24:
    print(url)
else:
    print(url[:14] + "…" + url[-4:])
PY
}

# Запись ключа в settings.json с сохранением прав и атомарной заменой
write_setting() {
    path="$1"
    value="$2"
    tmp="$SETTINGS_JSON.tmp"
    jq --arg v "$value" "$path = \$v" "$SETTINGS_JSON" >"$tmp" || {
        rm -f "$tmp"
        echo "Не удалось изменить $path в $SETTINGS_JSON" >&2
        return 1
    }
    chmod 600 "$tmp" 2>/dev/null
    mv "$tmp" "$SETTINGS_JSON" || {
        rm -f "$tmp"
        echo "Не удалось записать $SETTINGS_JSON" >&2
        return 1
    }
}

run_update() {
    [ -x "$UPDATER" ] || {
        echo "Скрипт обновления не найден: $UPDATER" >&2
        return 1
    }
    "$UPDATER"
}

do_sub() {
    require_settings || return 1

    case "$1" in
    set)
        new_url=${2:-}
        case "$new_url" in
        http://* | https://* | file://*) ;;
        "")
            echo "Использование: xpower-client sub set <URL>" >&2
            return 2
            ;;
        *)
            echo "URL должен начинаться с http://, https:// или file://" >&2
            return 2
            ;;
        esac
        write_setting ".subscription.url" "$new_url" || return 1
        echo "URL подписки обновлён: $(mask_url "$new_url")"
        echo "Пересобираю конфигурацию…"
        run_update || {
            echo "Обновление не удалось — прежний config.json остаётся рабочим" >&2
            return 1
        }
        ;;
    ua)
        new_ua=${2:-}
        if [ -z "$new_ua" ]; then
            echo "Использование: xpower-client sub ua <User-Agent>" >&2
            return 2
        fi
        write_setting ".subscription.user_agent" "$new_ua" || return 1
        echo "User-Agent обновлён: $new_ua"
        echo "Пересобираю конфигурацию…"
        run_update || {
            echo "Обновление не удалось — прежний config.json остаётся рабочим" >&2
            return 1
        }
        ;;
    "" | --full)
        url=$(setting_value ".subscription.url")
        if [ -z "$url" ]; then
            echo "URL подписки не задан в $SETTINGS_JSON" >&2
            echo "Задайте: xpower-client sub set <URL>" >&2
            return 1
        fi
        echo "=== Подписка ==="
        if [ "$1" = "--full" ]; then
            echo "URL:              $url"
        else
            echo "URL:              $(mask_url "$url")   (полностью: sub --full)"
        fi
        echo "User-Agent:       $(setting_value ".subscription.user_agent")"
        echo "Фильтр профиля:   $(setting_value ".subscription.remarks_filter")"
        echo "Все профили:      $(setting_value ".subscription.fallback_all")"
        echo "HWID:             $(setting_value ".hwid")"

        if [ -f "$CONFIG_JSON" ]; then
            size=$(wc -c <"$CONFIG_JSON" 2>/dev/null)
            when=$(date -r "$CONFIG_JSON" '+%d.%m %H:%M' 2>/dev/null)
            echo "Конфигурация:     $CONFIG_JSON ($(human_bytes "${size:-0}"), $when)"
        else
            echo "Конфигурация:     не собрана (xpower-client update)"
        fi

        python3 -B - "$CONFIG_JSON" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        config = json.load(source)
except (OSError, ValueError):
    print("Профили:          — (конфигурация не собрана)")
    print("Балансировщики:   — (конфигурация не собрана)")
    sys.exit(0)

groups = {}
for outbound in config.get("outbounds") or []:
    tag = outbound.get("tag") if isinstance(outbound, dict) else None
    if not isinstance(tag, str) or not tag.startswith("proxy-"):
        continue
    name = tag[len("proxy-"):]
    name = name.rsplit("-", 1)[0] if name.rsplit("-", 1)[-1].isdigit() else name
    groups[name] = groups.get(name, 0) + 1

if groups:
    print("Профили:")
    for name in sorted(groups, key=lambda n: (-groups[n], n)):
        print("  %-28s %3d" % (name, groups[name]))
    print("Итого:            %d профилей, %d узлов" % (len(groups), sum(groups.values())))
else:
    print("Профили:          — (нет узлов proxy-* в конфигурации)")

pools = []
for tag in ("balancer", "balancer-stream"):
    for balancer in (config.get("routing") or {}).get("balancers") or []:
        if balancer.get("tag") == tag:
            strategy = (balancer.get("strategy") or {}).get("type") or "?"
            pools.append("%s (%s)" % (tag, strategy))
if pools:
    print("Балансировщики:   %s" % ", ".join(pools))
PY
        ;;
    *)
        echo "Неизвестная подкоманда sub: $1" >&2
        echo "Использование: xpower-client sub [--full|set <URL>|ua <User-Agent>]" >&2
        return 2
        ;;
    esac
