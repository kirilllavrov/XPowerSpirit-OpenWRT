{
  "subscription": {
    "url": "",
    "user_agent": "XPower/1.0",
    "remarks_filter": "",
    "domain_whitelist": []
  },
  "hwid": "",
  "device_model": "",
  "device_os": "",
  "ver_os": "",
  "routing": {
    "domainStrategy": "IPOnDemand",
    "block_domains": [
      "geosite:category-ads"
    ],
    "direct_ips": [
      "geoip:ru",
      "geoip:private"
    ],
    "direct_domains": [
      "geosite:private",
      "geosite:category-browser",
      "geosite:category-cdn-ru",
      "geosite:category-mobile",
      "geosite:category-ru"
    ],
    "proxy_domains": [
      "geosite:category-streaming",
      "geosite:category-games"
    ],
    "bs_domains": [
      "geosite:category-whitelist"
    ],
    "bs_ips": [
      "geoip:whitelist"
    ],
    "dns_direct_address": "https+local://common.dot.dns.yandex.net/dns-query",
    "dns_proxy_address": "https://cloudflare-dns.com/dns-query",
    "dns_hosts": {
      "common.dot.dns.yandex.net": ["77.88.8.1", "77.88.8.8"],
      "cloudflare-dns.com": ["1.0.0.1", "1.1.1.1"],
      "dns.google": ["8.8.8.8", "8.8.4.4"],
      "dns.nextdns.io": ["45.90.28.0", "45.90.30.0"]
    }
  },
  "bs": {
    "interval": 60,
    "confirmations": 3,
    "back_confirmations": 2,
    "min_dwell": 600,
    "probe_external": [
      {
        "host": "connectivitycheck.gstatic.com",
        "port": 80,
        "path": "/generate_204",
        "tls": false
      }
    ],
    "probe_bs": [
      {
        "host": "ya.ru",
        "port": 443,
        "path": "/",
        "tls": true
      },
      {
        "host": "vk.com",
        "port": 443,
        "path": "/",
        "tls": true
      }
    ]
  },
  "geo": {
    "geoip_url": "https://raw.githubusercontent.com/kirilllavrov/geoip-builder/release/geoip.dat",
    "geosite_url": "https://raw.githubusercontent.com/kirilllavrov/geosite-builder/release/geosite.dat"
  }
}
