    "route_table": 100
  },
  "routing": {
    "domainStrategy": "IPOnDemand",
    "doh_domains": [
      "common.dot.dns.yandex.net",
      "cloudflare-dns.com",
      "dns.comss.one",
      "dns.quad9.net",
      "doh.opendns.com",
