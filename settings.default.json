  },
  "dns": {
    "queryStrategy": "UseIPv4",
    "disableCache": false,
    "serveStale": true,
    "serveExpiredTTL": 600,
    "disableFallback": false,
    "disableFallbackIfMatch": true,
    "enableParallelQuery": true,
    "hosts": {
      "common.dot.dns.yandex.net": [
        "77.88.8.1",
        "77.88.8.8"
      ],
      "cloudflare-dns.com": [
        "1.0.0.1",
        "1.1.1.1"
      ],
      "dns.comss.one": [
        "185.146.157.78",
        "195.133.25.16"
      ],
      "dns.nextdns.io": [
        "45.90.28.0",
        "45.90.30.0"
      ]
    },
    "servers": [
      {
        "address": "https+local://common.dot.dns.yandex.net/dns-query",
        "domains": [
          "geosite:category-ru"
